---
// Header comun: logo + tab-uri produs + autentificare (demo)
const { active = '' } = Astro.props; // 'casino' | 'sport'
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="logo" href="index.html" aria-label="1X2.ro — Acasă">
      <span>1</span><span class="x">X</span><span>2</span><span class="tld">.ro</span>
    </a>

    <nav class="product-nav header-nav-desktop" aria-label="Produse">
      <a href="index.html" class={active === 'casino' ? 'active' : ''} aria-current={active === 'casino' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        Casino
      </a>
      <a href="sport.html" class={active === 'sport' ? 'active' : ''} aria-current={active === 'sport' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v3.5M12 17.5V21M4.2 8.4l3.3 1.1M16.5 14.5l3.3 1.1M4.2 15.6l3.3-1.1M16.5 9.5l3.3-1.1M12 6.5l3.4 2.5-1.3 4h-4.2l-1.3-4z"/></svg>
        Sport
      </a>
    </nav>

    <div class="header-auth">
      <a class="btn btn-ghost btn-sm" href="#">Intră în cont</a>
      <a class="btn btn-lime btn-sm" href="#">Înregistrare</a>
    </div>

    <button class="burger" aria-label="Meniu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu">
  <nav class="product-nav" aria-label="Produse">
    <a href="index.html" class={active === 'casino' ? 'active' : ''} aria-current={active === 'casino' ? 'page' : undefined}>Casino</a>
    <a href="sport.html" class={active === 'sport' ? 'active' : ''} aria-current={active === 'sport' ? 'page' : undefined}>Sport</a>
  </nav>
  <div class="auth-row">
    <a class="btn btn-ghost" href="#">Intră în cont</a>
    <a class="btn btn-lime" href="#">Înregistrare</a>
  </div>
</div>
