---
import Base from '../layouts/Base.astro';
---
<Base
  title="1X2.ro — Pariuri Sportive | Cote Mărite & Pariuri Live"
  description="1X2.ro — pariuri sportive online: fotbal, tenis, baschet, pariuri live și cote mărite. Demo front-end."
  active="sport"
  bilet={true}
>
    <!-- ================= HERO ÎMPĂRȚIT ================= -->
    <section class="shell" aria-label="Pariuri sportive">
      <div class="sport-hero-grid">
        <div class="sport-hero">
          <p class="kicker">Weekend de derby · cote mărite</p>
          <h1 class="dsp">Simte <em>adrenalina</em> fiecărui meci</h1>
          <p>Cote mărite la SuperLiga, Champions League, tenis și baschet. Pariuri live, bet builder și retrageri în câteva minute, dintr-un singur cont.</p>
          <a class="btn btn-lime btn-lg" href="#meciuri">Pariază acum</a>
        </div>

        <aside class="boost-card reveal" aria-label="Cota zilei">
          <span class="tag">Cota zilei · Boost</span>
          <h2 class="boost-title dsp">Dinamo sau Rapid marchează</h2>
          <p class="boost-match">Dinamo — Rapid · duminică · 20:00</p>
          <div class="boost-odds">
            <span class="boost-old num" aria-label="Cota veche">1.45</span>
            <svg class="boost-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <span class="boost-new num" aria-label="Cota mărită">2.00</span>
          </div>
          <button class="btn btn-lime odd-btn-boost" type="button" data-odds="2.00" data-match="Dinamo — Rapid" data-pick="Boost: ambele marchează">Adaugă pe bilet</button>
          <span class="boost-fine">Demo · T&amp;C se aplică · 18+</span>
        </aside>
      </div>

      <!-- Sporturi -->
      <div class="cat-row" role="list">
        <a class="cat-pill active" href="#meciuri" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6.5l3.4 2.5-1.3 4h-4.2l-1.3-4z"/></svg>
          Fotbal
        </a>
        <a class="cat-pill" href="#meciuri" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5 5.5C9 9 9 15 5.5 18.8M18.9 5.2C15 9 15 15 19 18.5"/></svg>
          Tenis
        </a>
        <a class="cat-pill" href="#meciuri" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 2.6 3 15.4 0 18M5.5 5.5c3.8 3.6 9.2 3.6 13 0M5.5 18.5c3.8-3.6 9.2-3.6 13 0"/></svg>
          Baschet
        </a>
        <a class="cat-pill" href="#live" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 3L5 13.5h6L11 21l8-10.5h-6z"/></svg>
          Live
        </a>
        <a class="cat-pill" href="#meciuri" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="11" rx="4"/><path d="M8 11v3M6.5 12.5h3M15.5 11.5h.01M17.5 13.5h.01"/></svg>
          eSports
        </a>
        <a class="cat-pill" href="index.html" role="listitem">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>
          Casino
        </a>
      </div>
    </section>

    <!-- ================= MECIURI DE TOP ================= -->
    <section class="section shell" id="meciuri" aria-label="Meciuri de top">
      <div class="section-head">
        <h2 class="section-title dsp">Meciuri <span class="tick">de top</span></h2>
        <a class="section-link" href="#">Toate competițiile (demo) →</a>
      </div>

      <div class="match-list">
        <article class="match-card reveal" style="--i: 0">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
              SuperLiga · Etapa 4 <span class="markets">· +212 piețe</span>
            </p>
            <h3 class="match-teams">FCSB <span class="vs">vs</span> Universitatea Craiova</h3>
            <p class="match-time">Sâmbătă · 21:30</p>
          </div>
          <div class="odds-row" aria-label="Cote 1X2" data-match="FCSB — U. Craiova">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.10</b></button>
            <button class="odd-btn" type="button" data-pick="X"><small aria-hidden="true">X</small><b>3.40</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>3.25</b></button>
          </div>
        </article>

        <article class="match-card reveal" style="--i: 1">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
              SuperLiga · Etapa 4 <span class="markets">· +245 piețe</span>
            </p>
            <h3 class="match-teams">Dinamo <span class="vs">vs</span> Rapid</h3>
            <p class="match-time">Duminică · 20:00 · Derby de București</p>
          </div>
          <div class="odds-row" aria-label="Cote 1X2" data-match="Dinamo — Rapid">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.75</b></button>
            <button class="odd-btn" type="button" data-pick="X"><small aria-hidden="true">X</small><b>3.10</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>2.55</b></button>
          </div>
        </article>

        <article class="match-card reveal" style="--i: 2">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z" stroke-linejoin="round"/></svg>
              UEFA Champions League <span class="markets">· +301 piețe</span>
            </p>
            <h3 class="match-teams">Real Madrid <span class="vs">vs</span> Manchester City</h3>
            <p class="match-time">Marți · 22:00</p>
          </div>
          <div class="odds-row" aria-label="Cote 1X2" data-match="Real Madrid — Man. City">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.45</b></button>
            <button class="odd-btn" type="button" data-pick="X"><small aria-hidden="true">X</small><b>3.60</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>2.70</b></button>
          </div>
        </article>

        <article class="match-card reveal" style="--i: 3">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z" stroke-linejoin="round"/></svg>
              UEFA Champions League <span class="markets">· +288 piețe</span>
            </p>
            <h3 class="match-teams">Inter <span class="vs">vs</span> Arsenal</h3>
            <p class="match-time">Miercuri · 22:00</p>
          </div>
          <div class="odds-row" aria-label="Cote 1X2" data-match="Inter — Arsenal">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.90</b></button>
            <button class="odd-btn" type="button" data-pick="X"><small aria-hidden="true">X</small><b>3.20</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>2.50</b></button>
          </div>
        </article>
      </div>
    </section>

    <!-- ================= LIVE ACUM ================= -->
    <section class="section shell" id="live" aria-label="Pariuri live">
      <div class="section-head">
        <h2 class="section-title dsp">LIVE <span class="tick">acum</span></h2>
        <a class="section-link" href="#">Toate meciurile live (demo) →</a>
      </div>

      <div class="match-list">
        <article class="match-card reveal" style="--i: 0">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
              SuperLiga
            </p>
            <h3 class="match-teams">CFR Cluj <span class="vs">vs</span> Farul Constanța</h3>
            <p class="match-time"><span class="live-tag"><i aria-hidden="true"></i>LIVE · min 67</span> · <span class="match-score num">1 – 1</span></p>
            <div class="minute-bar" role="img" aria-label="Minutul 67 din 90"><i style="--p: .74"></i></div>
          </div>
          <div class="odds-row" aria-label="Cote 1X2 live" data-match="CFR Cluj — Farul">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.30</b></button>
            <button class="odd-btn" type="button" data-pick="X"><small aria-hidden="true">X</small><b>2.05</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>4.80</b></button>
          </div>
        </article>

        <article class="match-card reveal" style="--i: 1">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5 5.5C9 9 9 15 5.5 18.8M18.9 5.2C15 9 15 15 19 18.5"/></svg>
              ATP · Turul 2
            </p>
            <h3 class="match-teams">Alcaraz <span class="vs">vs</span> Sinner</h3>
            <p class="match-time"><span class="live-tag"><i aria-hidden="true"></i>LIVE · Set 2</span> · <span class="match-score num">6-4, 3-3</span></p>
          </div>
          <div class="odds-row" aria-label="Cote live" data-match="Alcaraz — Sinner">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>1.65</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>2.20</b></button>
          </div>
        </article>

        <article class="match-card reveal" style="--i: 2">
          <div class="match-info">
            <p class="match-league">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 2.6 3 15.4 0 18"/></svg>
              Euroliga · Baschet
            </p>
            <h3 class="match-teams">Panathinaikos <span class="vs">vs</span> Real Madrid</h3>
            <p class="match-time"><span class="live-tag"><i aria-hidden="true"></i>LIVE · Sfert 3</span> · <span class="match-score num">58 – 61</span></p>
          </div>
          <div class="odds-row" aria-label="Cote live" data-match="Panathinaikos — Real Madrid">
            <button class="odd-btn" type="button" data-pick="1"><small aria-hidden="true">1</small><b>2.40</b></button>
            <button class="odd-btn" type="button" data-pick="2"><small aria-hidden="true">2</small><b>1.55</b></button>
          </div>
        </article>
      </div>
    </section>

    <!-- ================= CROSS-SELL CASINO ================= -->
    <section class="shell" aria-label="Casino">
      <div class="cross-sell reveal">
        <div>
          <h2 class="dsp">Pauză de <em>meci</em>? Încearcă Casino</h2>
          <p>Sloturi populare, mese live și jackpot progresiv, cu același cont și același portofel. Distracția continuă între reprize.</p>
        </div>
        <a class="btn btn-lime btn-lg" href="index.html">Mergi la Casino</a>
      </div>
    </section>
  <Fragment slot="after-nav">
  <!-- ================= BILET DEMO ================= -->
  <button class="betslip-fab" type="button" data-betslip-fab hidden>
    Bilet <span class="count" data-bs-count>0</span>
  </button>

  <aside class="betslip" data-betslip aria-label="Biletul meu (demo)">
    <div class="betslip-head">
      <h2 class="dsp">Biletul meu <span class="count num" data-bs-count>0</span></h2>
      <button class="betslip-close" type="button" aria-label="Închide biletul" data-bs-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="betslip-body">
      <div data-bs-items></div>
      <p class="bs-empty" data-bs-empty>Alege o cotă din listă și construiește-ți biletul.</p>
      <div class="bs-stake">
        <label for="bs-stake-input">Miză (RON)</label>
        <input id="bs-stake-input" type="text" inputmode="decimal" name="stake" value="50" autocomplete="off" spellcheck="false" placeholder="ex.: 50">
      </div>
      <p class="bs-total">Câștig potențial <span class="num" data-bs-total aria-live="polite">0,00 RON</span></p>
      <button class="btn btn-lime" type="button" data-bs-submit>Plasează biletul (demo)</button>
    </div>
  </aside>

  <div class="toast" role="status" aria-live="polite" data-toast></div>
  </Fragment>
</Base>
