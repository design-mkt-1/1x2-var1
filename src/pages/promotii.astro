---
import Base from '../layouts/Base.astro';
---
<Base
  title="1X2.ro — Promoții | Bonusuri Casino & Sport"
  description="Toate ofertele 1X2: bonus de bun venit, rotiri gratuite, cote mărite și programul de loialitate 1X2 Club. Demo front-end."
  active="oferte"
>
  <section class="shell page-head">
    <h1 class="dsp">Promoții <span class="tick">1X2</span></h1>
    <p>Oferte demo pentru casino și sport. Un singur cont, un singur portofel — bonusurile se văd în ambele produse.</p>
  </section>

  <section class="section shell" aria-label="Oferte casino">
    <div class="section-head">
      <h2 class="section-title dsp">Casino</h2>
      <a class="section-link" href="index.html">Mergi la Casino →</a>
    </div>
    <div class="promo-bento">
      <article class="promo-card big lit reveal" style="--i: 0">
        <span class="promo-tag">Ofertă de bun venit</span>
        <h3 class="promo-title dsp">Până la 1.500 RON + 150 rotiri</h3>
        <p class="promo-copy">Pachetul complet la primul depozit: bonus de casino și rotiri gratuite la sloturile populare.</p>
        <a class="btn btn-lime" href="#">Revendică bonusul</a>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card pa reveal" style="--i: 1">
        <span class="promo-tag">Zilnic în aplicație</span>
        <h3 class="promo-title dsp">Cadouri zilnice</h3>
        <p class="promo-copy">Deschide aplicația și primești rotiri gratuite sau bonusuri, în fiecare zi.</p>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card pb reveal" style="--i: 2">
        <span class="promo-tag">Program de loialitate</span>
        <h3 class="promo-title dsp">1X2 Club</h3>
        <p class="promo-copy">Puncte la fiecare rundă, niveluri și premii lunare pentru jucătorii activi.</p>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card wide reveal" style="--i: 3">
        <div>
          <span class="promo-tag">Turneu săptămânal</span>
          <h3 class="promo-title dsp">Cursa sloturilor</h3>
          <p class="promo-copy">Clasament săptămânal la sloturile participante, cu premii în bani și rotiri.</p>
        </div>
        <a class="btn btn-lime" href="index.html#sloturi">Vezi sloturile</a>
      </article>
    </div>
  </section>

  <section class="section shell" aria-label="Oferte sport">
    <div class="section-head">
      <h2 class="section-title dsp">Sport</h2>
      <a class="section-link" href="sport.html">Mergi la Sport →</a>
    </div>
    <div class="promo-bento">
      <article class="promo-card big reveal" style="--i: 0">
        <span class="promo-tag">Weekend de derby</span>
        <h3 class="promo-title dsp">Cote mărite la derby</h3>
        <p class="promo-copy">Cote mărite la derby-urile din SuperLiga și Champions League, în fiecare weekend.</p>
        <a class="btn btn-lime" href="sport.html">Vezi cotele</a>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card pa reveal" style="--i: 1">
        <span class="promo-tag">Bilet fără risc</span>
        <h3 class="promo-title dsp">Primul pariu asigurat</h3>
        <p class="promo-copy">Dacă primul tău bilet nu intră, primești miza înapoi ca bonus, până la 100 RON.</p>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card pb reveal" style="--i: 2">
        <span class="promo-tag">Bilet combinat</span>
        <h3 class="promo-title dsp">Bonus combo +50%</h3>
        <p class="promo-copy">Câștig suplimentar la biletele cu 5 sau mai multe selecții, direct pe bilet.</p>
        <span class="promo-fine">Demo · T&amp;C se aplică · 18+</span>
      </article>
      <article class="promo-card wide reveal" style="--i: 3">
        <div>
          <span class="promo-tag">Cota zilei</span>
          <h3 class="promo-title dsp">Boost zilnic</h3>
          <p class="promo-copy">În fiecare zi, o cotă aleasă de traderii noștri primește boost. Azi: Dinamo sau Rapid marchează, cota 2.00.</p>
        </div>
        <a class="btn btn-lime" href="sport.html">Adaugă pe bilet</a>
      </article>
    </div>
  </section>
</Base>
